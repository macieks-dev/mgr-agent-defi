# ===== Foundry / Anvil =====
# Default value for local host execution.
# Docker Compose sets ANVIL_RPC_URL=http://anvil:8545 for container runs.
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337

# ===== Optional external RPC =====
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# ===== Optional external data access =====
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCP_PROJECT_ID=your-project-id

# ===== Training =====
TENSORBOARD_LOG_DIR=./runs
MODEL_SAVE_DIR=./models
SEED=42
TOTAL_TIMESTEPS=500000
N_ENVS=8

# ===== Hook Deployment =====
# These values are populated only when the deployment flow is used.
HOOK_ADDRESS=
POOL_MANAGER_ADDRESS=
OPERATOR_ADDRESS=
# Default Anvil account for local testing only.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
